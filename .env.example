# Application
APP_NAME=SmartCart
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8904
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# Development (default):
DATABASE_URL=sqlite:///./smartcart.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://smartcart:smartcart@localhost:5432/smartcart

# CORS
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8904"]

# Stripe (Sandbox)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CURRENCY=usd

# OpenAI (optional — leave blank to use heuristic recommendations)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Business defaults
DEFAULT_TAX_RATE=0.08
DEFAULT_SHIPPING_FLAT=5.99
FREE_SHIPPING_THRESHOLD=75.00

# Rate limiting
RATE_LIMIT=100/minute

# Admin seed
ADMIN_EMAIL=admin@smartcart.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=SmartCart Admin
